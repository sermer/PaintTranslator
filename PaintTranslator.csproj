<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>PaintTranslator</RootNamespace>
    <AssemblyName>PaintTranslator</AssemblyName>
    <!-- Magick.NET ships native codecs per platform. Without a pinned RID, NuGet copies
         the Linux and macOS binaries alongside the Windows ones and the build output
         grows from 25 MB to 131 MB; this app is Windows-only, so pin it. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- The owner develops on macOS. This lets the Windows-only app compile there
         (the desktop reference pack is downloaded on restore); it still only runs on
         Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- WFO1000 is a .NET 10 WinForms design-time-serialization analyzer that fires on
         custom control properties (ModernTrackBar, ImageCanvas) with no ShouldSerialize/
         Reset pair. It flags a Designer-support gap, not a behavior bug, and is the same
         class of noise as CA1416 that this task is not chasing. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <!-- Only for the unsafe Span copy in GdiImageAdapter.ToBitmap; Core stays managed-only. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Decodes the formats GDI+ has no support for: WEBP, AVIF, HEIC/HEIF and PSD. -->
    <PackageReference Include="Magick.NET-Q8-x64" Version="14.15.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The colour, mixing and imaging kernel. It is platform-neutral and lives in its
         own assembly so the same code can be compiled for a non-WinForms client. -->
    <ProjectReference Include="Core\PaintTranslator.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- UiThemeTests asserts on the palette, which is internal to the app because
         nothing outside the app's own controls has any business reading it. The
         Windows-only test assembly is the one place that needs the exception. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>PaintTranslator.Windows.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Core, BlendTests and the two test projects are their own projects; keep their
         sources out of this project's default globs. -->
    <Compile Remove="Core\**" />
    <EmbeddedResource Remove="Core\**" />
    <None Remove="Core\**" />
    <Compile Remove="BlendTests\**" />
    <EmbeddedResource Remove="BlendTests\**" />
    <None Remove="BlendTests\**" />
    <Compile Remove="Tests\**" />
    <EmbeddedResource Remove="Tests\**" />
    <None Remove="Tests\**" />
    <Compile Remove="Tests.Windows\**" />
    <EmbeddedResource Remove="Tests.Windows\**" />
    <None Remove="Tests.Windows\**" />
    <!-- The offline coefficient ingest is its own console project and must never be
         compiled into the application. -->
    <Compile Remove="Tools\**" />
    <EmbeddedResource Remove="Tools\**" />
    <None Remove="Tools\**" />
  </ItemGroup>

</Project>
